SPRING_CLOUD_NACOS_DISCOVERY_PASSWORD="nacos-password"

SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.p6spy.engine.spy.P6SpyDriver
SPRING_DATASOURCE_URL="jdbc:p6spy:mysql://127.0.0.1:3306/database_name?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC"
SPRING_DATASOURCE_USERNAME="database-username"
SPRING_DATASOURCE_PASSWORD="database-password"

SPRING_DATA_REDIS_HOST="127.0.0.1"
SPRING_DATA_REDIS_PORT="6379"
SPRING_DATA_REDIS_PASSWORD="redis-password"

FRAMEWORK_GATEWAY_TOKEN_SECRET="token_secret_here(length >= 32)"

