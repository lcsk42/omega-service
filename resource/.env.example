FRAMEWORK_FILE_UPLOAD_ACCESS_KEY_SECRET="access_key_secret"
FRAMEWORK_FILE_UPLOAD_BUCKET_NAME="bucket_name"
FRAMEWORK_FILE_UPLOAD_REGION="region(us-west-1)"

